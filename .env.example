# Copy this file to .env.local and fill in real values from the Supabase
# dashboard (Project Settings -> API). Never commit .env.local — it's gitignored.

NEXT_PUBLIC_SUPABASE_URL=https://hmkjszolqnpcsoatrgcu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_REDIRECT_URL=http://localhost:3000

# For `npm run test:e2e` (Playwright smoke tests) — a dedicated test
# account's login, not your own. Authenticated tests skip themselves if
# these aren't set. Also needed as GitHub Actions secrets of the same
# names for CI.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# For POST /api/pending-games (staged by atlas's gametracker_stage_game MCP
# tool after an AI client classifies pasted game text for a SIGNED-IN atlas
# user — see that route's comments; the request carries that user's own
# user_id, resolved from their own login, not one hardcoded account).
# SUPABASE_SERVICE_ROLE_KEY is from the same dashboard page as the anon key
# above, under "service_role" — never expose it client-side.
# GAMETRACKER_API_KEY is a random string you generate yourself (e.g.
# `openssl rand -hex 32`) and also set as atlas's GAMETRACKER_API_KEY — it
# authenticates atlas as a relay, not any particular end user.
SUPABASE_SERVICE_ROLE_KEY=
GAMETRACKER_API_KEY=
